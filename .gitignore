# ─── Maven / Java build artifacts ────────────────────────────────────────────
target/
*.class
*.jar
*.war
*.nar
*.ear
hs_err_pid*
replay_pid*
target/generated-sources/
target/generated-test-sources/
.flattened-pom.xml

# ─── Maven wrapper (keep the jar) ────────────────────────────────────────────
.mvn/wrapper/maven-wrapper.jar
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# ─── IDE: IntelliJ IDEA ──────────────────────────────────────────────────────
.idea/
*.iml
*.iws
*.ipr

# ─── IDE: Eclipse / STS ──────────────────────────────────────────────────────
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache

# ─── IDE: VS Code ────────────────────────────────────────────────────────────
.vscode/

# ─── IDE: NetBeans ───────────────────────────────────────────────────────────
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/
build/

# ─── OS junk ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ─── Logs / runtime ──────────────────────────────────────────────────────────
*.log
logs/
nohup.out

# ─── Env / secrets (never commit real secrets) ───────────────────────────────
.env
.env.local
.env.*.local
*.pem
*.key

# ─── Generated client code (subscription-lib ships gen/) ────────────────────
gen/

# ─── Claude Code local config (Sprint 5.10) ─────────────────────────────
# Per-developer Claude Code session state — never track.
# The umbrella E:/WORK/fin_app/.gitignore also excludes .claude/;
# this is defense-in-depth at the per-service level (Sprint 5.11
# finding: person-setting-service/.claude/settings.local.json slipped
# through before this exclusion existed).
.claude/

# ─── Flutter / Dart (harmless in pure-JVM services) ─────────────────────────
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.packages
**/build/
**/coverage/
**/.pub-cache/
**/.pub/

# ─── Coverage / IDE extras ──────────────────────────────────────────────────
coverage/
.nyc_output/
*.tgz

# ─── HELP.md (Spring Initializr boilerplate) ─────────────────────────────────
HELP.md
